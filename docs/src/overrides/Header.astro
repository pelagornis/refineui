---
import { DocsHeaderBrand, DocsHeaderNav, DocsHeaderSearch, DocsHeaderTools } from "./DocsHeader";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const currentPath = Astro.url.pathname;
---

<div data-refineui-docs-header>
    <DocsHeaderBrand title={siteTitle} titleHref={siteTitleHref} />
    <DocsHeaderNav client:load currentPath={currentPath} />
    <div data-refineui-docs-header-end>
        <DocsHeaderSearch client:load />
        <DocsHeaderTools client:load />
    </div>
</div>
