---
import config from "virtual:starlight/user-config";
import { DocsShell } from "./DocsShell";
import { DocsSidebar } from "./DocsSidebar";
import { serializeNav } from "./nav";

const { hasSidebar, siteTitle, siteTitleHref, sidebar } = Astro.locals.starlightRoute;
const entries = hasSidebar ? serializeNav(sidebar) : [];
const githubHref = Array.isArray(config.social)
    ? config.social.find((entry) => entry.icon === "github")?.href
    : undefined;
---

<div class="page sl-flex" data-docs-page={hasSidebar ? "with-sidebar" : "flush"}>
    <header class="header"><slot name="header" /></header>
    {
        hasSidebar && (
            <nav
                class="sidebar print:hidden"
                data-docs-mobile-sidebar
                aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
            >
                <div id="starlight__sidebar" class="sidebar-pane">
                    <div class="sidebar-content sl-flex">
                        <DocsSidebar client:load title={siteTitle} titleHref={siteTitleHref} entries={entries} />
                    </div>
                </div>
            </nav>
        )
    }
    <div class="main-frame">
        {
            hasSidebar ? (
                <DocsShell
                    client:load
                    title={siteTitle}
                    titleHref={siteTitleHref}
                    entries={entries}
                    githubHref={githubHref}
                >
                    <slot />
                </DocsShell>
            ) : (
                <slot />
            )
        }
    </div>
</div>

<style>
    @layer starlight.core {
        .page {
            flex-direction: column;
            min-height: 100vh;
        }

        .header {
            z-index: var(--sl-z-index-navbar);
            position: fixed;
            inset-inline-start: 0;
            inset-block-start: 0;
            width: 100%;
            height: var(--sl-nav-height);
            border-bottom: 1px solid var(--sl-color-hairline-shade);
            padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
            padding-inline-end: var(--sl-nav-pad-x);
            background-color: var(--sl-color-bg-nav);
        }

        .sidebar-pane {
            visibility: var(--sl-sidebar-visibility, hidden);
            position: fixed;
            z-index: var(--sl-z-index-menu);
            inset-block: var(--sl-nav-height) 0;
            inset-inline-start: 0;
            width: 100%;
            background-color: var(--sl-color-black);
            overflow-y: auto;
        }

        :global(body[data-mobile-menu-expanded]) [data-docs-mobile-sidebar] .sidebar-pane {
            --sl-sidebar-visibility: visible;
        }

        .sidebar-content {
            height: 100%;
            min-height: max-content;
            padding: 0;
            flex-direction: column;
            gap: 0;
        }

        .main-frame {
            /* Mobile sticky TOC sits under the nav — reserve both. */
            padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
            padding-inline-start: 0;
            min-height: calc(100vh - var(--sl-nav-height));
        }

        @media (min-width: 50rem) {
            /* Desktop TOC is in-flow (right rail) — do not reserve mobile TOC height. */
            .main-frame {
                padding-top: var(--sl-nav-height);
                height: calc(100vh - var(--sl-nav-height));
                min-height: calc(100vh - var(--sl-nav-height));
            }

            /* Desktop: RefineUI DocsShell owns the rail — hide Starlight fixed pane. */
            :global([data-docs-page="with-sidebar"]) .sidebar {
                display: none;
            }

            .sidebar-pane {
                --sl-sidebar-visibility: hidden;
            }
        }
    }
</style>
