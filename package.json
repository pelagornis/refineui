{
  "name": "@refineui/project",
  "version": "0.0.0",
  "private": true,
  "workspaces": ["packages", "documentation", "examples"],
  "scripts": {
    "build": "pnpm run build:tokens && pnpm run build:react",
    "build:tokens": "pnpm --filter @refineui/tokens build",
    "build:react": "pnpm --filter @refineui/react build",
    "docs": "pnpm --filter @refineui/documentation dev",
    "docs:build": "pnpm run build && pnpm --filter @refineui/documentation build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "vitest": "3.1.3"
  }
}
