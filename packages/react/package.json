{
  "name": "@refineui/react",
  "version": "0.1.0",
  "description": "RefineUI React components — Pelagornis RefineUI Web Kit",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./authoring-manifest": {
      "types": "./dist/authoring-manifest.d.ts",
      "import": "./dist/authoring-manifest.js",
      "require": "./dist/authoring-manifest.cjs"
    },
    "./authoring-manifest.json": "./spec/authoring/manifest.json",
    "./package.json": "./package.json",
    "./refineui.css": "./refineui.css"
  },
  "files": [
    "dist",
    "spec",
    "refineui.css"
  ],
  "scripts": {
    "build": "node ../../scripts/ws.mjs @refineui/utilities build && node ../../scripts/ws.mjs @refineui/tokens build && node scripts/generate-authoring-manifest.mjs && node scripts/validate-authoring-manifest.mjs && tsup && node scripts/generate-refineui-css.mjs && node scripts/generate-component-spec.mjs",
    "dev": "node scripts/generate-authoring-manifest.mjs && tsup --watch",
    "generate:authoring": "node scripts/generate-authoring-manifest.mjs",
    "validate:authoring": "node scripts/validate-authoring-manifest.mjs",
    "verify:authoring-presets": "node scripts/verify-authoring-presets.mjs",
    "test:authoring": "node scripts/validate-authoring-manifest.mjs && vitest run --config vitest.authoring.config.ts",
    "test:authoring:browser": "vitest run --config vitest.authoring.browser.config.ts"
  },
  "dependencies": {
    "@refineui/tokens": "workspace:*",
    "@refineui/utilities": "workspace:*",
    "@refineui/web-icons": "^0.3.39",
    "clsx": "2.1.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "jsdom": "^30.1.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pelagornis/refineui.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  }
}
