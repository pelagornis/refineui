{
  "name": "@refineui/react",
  "version": "0.0.1",
  "description": "RefineUI React components — Pelagornis RefineUI Web Kit",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./refineui.css": "./refineui.css"
  },
  "files": [
    "dist",
    "spec",
    "refineui.css"
  ],
  "scripts": {
    "build": "node ../../scripts/ws.mjs @refineui/utilities build && node ../../scripts/ws.mjs @refineui/tokens build && tsup && node scripts/generate-refineui-css.mjs && node scripts/generate-component-spec.mjs",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@refineui/tokens": "workspace:*",
    "@refineui/utilities": "workspace:*",
    "@refineui/web-icons": "^0.3.32",
    "clsx": "2.1.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pelagornis/refineui.git",
    "directory": "packages/react"
  }
}
