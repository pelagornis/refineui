{
  "$schema": "../schema/component-spec.schema.json",
  "component": "calendar",
  "version": 1,
  "export": "Calendar",
  "anatomy": {
    "root": "calendar",
    "day": "calendar-day"
  },
  "attributes": {
    "data-refineui": "calendar"
  },
  "states": {
    "pseudo": [
      "focus-visible"
    ],
    "environment": [
      "forced-colors",
      "dir"
    ]
  },
  "accessibility": {
    "calendar": {
      "element": "div",
      "role": "grid"
    },
    "calendar-day": {
      "element": "button",
      "role": "gridcell"
    }
  },
  "keyboard": {
    "Enter": {
      "action": "activate",
      "native": true
    },
    "Space": {
      "action": "activate",
      "native": true
    }
  },
  "focus": {
    "visual": {
      "required": true,
      "selector": ":focus-visible"
    }
  },
  "layout": {
    "direction": "logical",
    "rtl": true
  }
}
