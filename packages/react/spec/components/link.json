{
  "$schema": "../schema/component-spec.schema.json",
  "component": "link",
  "version": 1,
  "export": "Link",
  "anatomy": {
    "root": "link"
  },
  "attributes": {
    "data-refineui": "link"
  },
  "states": {
    "pseudo": [
      "focus-visible"
    ],
    "environment": [
      "forced-colors",
      "dir",
      "prefers-contrast"
    ]
  },
  "keyboard": {
    "Enter": {
      "action": "activate",
      "native": true
    }
  },
  "focus": {
    "visual": {
      "required": true,
      "selector": ":focus-visible"
    }
  },
  "layout": {
    "direction": "logical",
    "rtl": true
  }
}
