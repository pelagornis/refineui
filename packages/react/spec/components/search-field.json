{
  "$schema": "../schema/component-spec.schema.json",
  "component": "search-field",
  "version": 1,
  "export": "SearchField",
  "anatomy": {
    "root": "search-field",
    "clear": "search-field-clear",
    "icon": "search-field-icon",
    "input": "search-field-input"
  },
  "attributes": {
    "data-refineui": "search-field"
  },
  "variants": {
    "appearance": [
      "filled",
      "plain"
    ]
  },
  "states": {
    "pseudo": [
      "focus-visible"
    ],
    "environment": [
      "forced-colors",
      "dir"
    ]
  },
  "accessibility": {
    "search-field-input": {
      "element": "input",
      "native": true
    },
    "search-field-clear": {
      "element": "button",
      "native": true
    }
  },
  "focus": {
    "visual": {
      "required": true,
      "selector": ":focus-visible"
    }
  },
  "layout": {
    "direction": "logical",
    "rtl": true
  },
  "keyboard": {
    "Escape": "close"
  }
}
