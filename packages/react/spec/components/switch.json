{
  "$schema": "../schema/component-spec.schema.json",
  "component": "switch",
  "version": 1,
  "export": "Switch",
  "anatomy": {
    "root": "switch"
  },
  "attributes": {
    "data-refineui": "switch"
  },
  "states": {
    "pseudo": [
      "focus-visible"
    ],
    "environment": [
      "forced-colors",
      "dir",
      "prefers-contrast"
    ]
  },
  "accessibility": {
    "switch": {
      "element": "button",
      "role": "switch",
      "native": true
    }
  },
  "keyboard": {
    "Enter": {
      "action": "activate",
      "native": true
    },
    "Space": {
      "action": "activate",
      "native": true
    }
  },
  "focus": {
    "visual": {
      "required": true,
      "selector": ":focus-visible"
    }
  },
  "layout": {
    "direction": "logical",
    "rtl": true
  },
  "tokens": {
    "visual": "switch"
  }
}
