{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
      "target": "ESNext",
      "outDir": "lib",
      "module": "ESNext",
      "lib": ["DOM", "ESNext"],
      "jsx": "react-jsx",
      "declaration": true,
      "sourceMap": true,
      "strict": true,
      "isolatedModules": true,
      "strictFunctionTypes": false,
      "experimentalDecorators": true,
      "importHelpers": false,
      "noUnusedLocals": true,
      "moduleResolution": "node",
      "preserveConstEnums": true,
      "skipLibCheck": true,
      "typeRoots": ["../../node_modules/@types", "../../typings"]
    },
    "include": ["src"]
}