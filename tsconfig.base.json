{
  "compilerOptions": {
    "rootDir": ".",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["DOM", "ESNext"],
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "typeRoots": ["node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@refineui/codemod": ["packages/codemod"],
      "@refineui/react": ["packages/react"],
      "@refineui/figma": ["packages/figma"],
      "@refineui/tokens": ["packages/tokens"],
      "@refineui/version": ["packages/version/src/index.ts"],
      "@refineui/utilities": ["packages/utilities"],
      "@refineui/utilities/animation": ["packages/utilities/src/animation.ts"],
      "@refineui/utilities/color": ["packages/utilities/src/color.ts"],
      "@refineui/utilities/react": ["packages/utilities/src/react.ts"],
    }
  },
  "exclude": ["node_modules", "dist"]
}