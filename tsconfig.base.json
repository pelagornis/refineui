{
  "compilerOptions": {
    "rootDir": ".",
    "target": "ES3",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2024", "DOM"],
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": ["node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@refineui/codemod": ["packages/codemod"],
      "@refineui/react": ["packages/react"],
      "@refineui/figma": ["packages/figma"],
      "@refineui/tokens": ["packages/tokens"],
    }
  },
  "exclude": ["node_modules"]
}