{
  "compilerOptions": {
    "rootDir": ".",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["DOM", "ESNext"],
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "typeRoots": ["node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@refineui/codemod": ["packages/codemod"],
      "@refineui/react": ["packages/react"],
      "@refineui/figma": ["packages/figma"],
      "@refineui/tokens": ["packages/tokens"],
      "@refineui/version": ["packages/version"],
      "@refineui/utilies": ["packages/utilies"],
    }
  },
  "exclude": ["node_modules", "dist"]
}